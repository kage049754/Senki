+function SelectLayer:filterCharacters(query)
+    query = string.lower(tostring(query or ""))
+    query = string.gsub(query, "^%s*(.-)%s*$", "%1")
+
+    local pageHasMatches = {}
+    local firstPage = nil
+    local matchCount = 0
+
+    for _, btn in ipairs(self.selectButtons or {}) do
+        local name = string.lower(tostring(btn._charName or ""))
+        local isPlaceholder = name == "none" or name == "_none"
+        local matches = not isPlaceholder and
+                        (query == "" or string.find(name, query, 1, true) ~= nil)
+        btn:setVisible(matches)
+        if matches then
+            local page = btn._pageIndex or 1
+            pageHasMatches[page] = true
+            firstPage = firstPage or page
+            matchCount = matchCount + 1
+        end
+    end
+
+    for i, pageBtn in ipairs(self.pageButtons or {}) do
+        pageBtn:setVisible(query == "" or pageHasMatches[i] == true)
+    end
+
+    if self.searchEmptyLabel then
+        self.searchEmptyLabel:setVisible(matchCount == 0)
+    end
+
+    if firstPage and firstPage ~= self.currentPage then
+        self:onPageButtonClick(firstPage, true)
+    end
+end
